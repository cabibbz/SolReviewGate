{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "approach", "confidence", "assumptions", "evidenceCited", "openQuestions"],
  "properties": {
    "answer": { "type": "string" },
    "approach": { "type": "string" },
    "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidenceCited": {
      "type": "array",
      "items": { "type": "string" }
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
